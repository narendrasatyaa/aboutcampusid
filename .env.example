# Public site URL for dashboard link in WA message
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Groq AI Assistant
GROQ_API_KEY="isi_api_key_groq"
GROQ_MODEL="llama-3.1-8b-instant"
