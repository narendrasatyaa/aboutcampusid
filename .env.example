# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aboutcampusid"

# Basic dashboard auth key
ADMIN_DASHBOARD_KEY="ganti_dengan_key_aman"

# WhatsApp notification config (recommended: Fonnte)
FONNTE_TOKEN="isi_token_fonnte"
